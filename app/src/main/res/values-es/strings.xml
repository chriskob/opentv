    <!-- ============================ About ============================ -->
    <string name="about_title">Acerca de OpenTV</string>
    <string name="about_version">Versión</string>
    <string name="about_update_available">Actualización disponible: %1$s. Se ofrecerá instalarla desde la pantalla de inicio.</string>
    <string name="about_up_to_date">Tienes la última versión.</string>
    <string name="about_checking">Comprobando…</string>
    <string name="about_check_updates">Buscar actualizaciones</string>
    <string name="about_what_is_title">Qué es</string>
    <string name="about_what_is_body">Un reproductor IPTV gratuito y de código abierto para Android TV, Fire TV y teléfonos. Es solo un reproductor: no proporciona canales; tú conectas el servicio que ya pagas. Nada de lo que introduces sale de tu dispositivo, salvo para comunicarse con tu propio proveedor.</string>
    <string name="about_built_open_title">Desarrollado de forma abierta</string>
    <string name="about_built_open_body">OpenTV se desarrolla de forma abierta, con la IA encargándose de buena parte de la programación bajo dirección humana; se dice con claridad, no se oculta. Al ser de código abierto, la marcha de una sola persona no puede acabar con él: cualquiera puede leer cada línea, compilarlo y continuarlo.</string>
    <string name="about_support_title">Apoya el proyecto</string>
    <string name="about_support_body">OpenTV es gratis y siempre lo será: nada está restringido. Si te resulta útil y quieres colaborar, un café ayuda a que sigan llegando las novedades: nuevas funciones, correcciones y soporte salen de ratos libres. Totalmente opcional y de verdad se agradece.</string>
    <string name="about_buy_coffee">Invítame a un café</string>
